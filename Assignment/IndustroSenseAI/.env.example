# Copy this file to .env and edit values as needed.
# Never commit a real .env file with production secrets to version control.

# ---- LLM (Ollama) ----
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# ---- Embeddings / Speech / Vision ----
EMBEDDING_MODEL=all-MiniLM-L6-v2
WHISPER_MODEL=base
VISION_MODEL=Salesforce/blip-image-captioning-base

# ---- Authentication (demonstration only — do not reuse in production) ----
INDUSTROSENSE_USERNAME=engineer
INDUSTROSENSE_PASSWORD=change_me

# ---- Rate limiting ----
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=600

# ---- Input validation ----
MAX_TEXT_LENGTH=2000
MAX_IMAGE_SIZE_MB=8
MAX_AUDIO_SIZE_MB=20

# ---- Chunking ----
CHUNK_SIZE=500
CHUNK_OVERLAP=80
